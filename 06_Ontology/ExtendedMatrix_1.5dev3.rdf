<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:ex="http://example.org/extended-matrix#">

  <!-- Classe per StratigraphicNode -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#StratigraphicNode">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label>Stratigraphic Node</rdfs:label>
  </rdf:Description>

  <!-- Classe per ActivityNodeGroup -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#ActivityNodeGroup">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label>Activity Node Group</rdfs:label>
  </rdf:Description>

  <!-- Classe per ParadataNodeGroup -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#ParadataNodeGroup">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label>Paradata Node Group</rdfs:label>
  </rdf:Description>

  <!-- Classe per DocumentNode -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#DocumentNode">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label>Document Node</rdfs:label>
  </rdf:Description>

  <!-- Classe per CombinerNode -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#CombinerNode">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label>Combiner Node</rdfs:label>
  </rdf:Description>

  <!-- Classe per ExtractorNode -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#ExtractorNode">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label>Extractor Node</rdfs:label>
  </rdf:Description>

  <!-- Classe per PropertyNode -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#PropertyNode">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label>Property Node</rdfs:label>
  </rdf:Description>

  <!-- Classe per EpochNode -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#EpochNode">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label>Epoch Node</rdfs:label>
  </rdf:Description>

  <!-- Proprietà stratigraphic_type associata a StratigraphicNode -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#stratigraphic_type">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:domain rdf:resource="http://example.org/extended-matrix#StratigraphicNode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:label>Stratigraphic Type</rdfs:label>
  </rdf:Description>

  <!-- Proprietà epoch associata a StratigraphicNode che punta a un EpochNode -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#epoch">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:domain rdf:resource="http://example.org/extended-matrix#StratigraphicNode"/>
    <rdfs:range rdf:resource="http://example.org/extended-matrix#EpochNode"/>
    <rdfs:label>Epoch</rdfs:label>
  </rdf:Description>

  <!-- Proprietà has_property tra StratigraphicNode e PropertyNode -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#has_property">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:domain rdf:resource="http://example.org/extended-matrix#StratigraphicNode"/>
    <rdfs:range rdf:resource="http://example.org/extended-matrix#PropertyNode"/>
    <rdfs:label>Has Property</rdfs:label>
  </rdf:Description>

  <!-- Proprietà source per ExtractorNode -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#source">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:domain rdf:resource="http://example.org/extended-matrix#ExtractorNode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:label>Source</rdfs:label>
  </rdf:Description>

  <!-- Proprietà combines per CombinerNode -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#combines">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:domain rdf:resource="http://example.org/extended-matrix#CombinerNode"/>
    <rdfs:range rdf:resource="http://example.org/extended-matrix#DocumentNode"/>
    <rdfs:label>Combines</rdfs:label>
  </rdf:Description>

  <!-- Proprietà connected_to per relazioni generali tra nodi -->
  <rdf:Description rdf:about="http://example.org/extended-matrix#connected_to">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:domain rdf:resource="http://example.org/extended-matrix#StratigraphicNode"/>
    <rdfs:range rdf:resource="http://example.org/extended-matrix#StratigraphicNode"/>
    <rdfs:label>Connected To</rdfs:label>
  </rdf:Description>

</rdf:RDF>
