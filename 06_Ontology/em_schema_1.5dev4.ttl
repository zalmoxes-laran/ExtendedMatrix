@prefix : <http://extendedmatrix.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

### Classi ###

:StratigraphicUnit a owl:Class ;
    rdfs:label "Stratigraphic Unit" .

:PropertyNode a owl:Class ;
    rdfs:label "Property Node" .

:DocumentNode a owl:Class ;
    rdfs:label "Document Node" .

:EpochNode a owl:Class ;
    rdfs:label "Epoch Node" .

:GroupNode a owl:Class ;
    rdfs:label "Group Node" .

:ActivityNodeGroup a owl:Class ;
    rdfs:label "Activity Node Group" ;
    rdfs:subClassOf :GroupNode .

:ParadataNodeGroup a owl:Class ;
    rdfs:label "Paradata Node Group" ;
    rdfs:subClassOf :GroupNode .

:TimeBranchNodeGroup a owl:Class ;
    rdfs:label "Time Branch Node Group" ;
    rdfs:subClassOf :GroupNode .

:ExtractorNode a owl:Class ;
    rdfs:label "Extractor Node" .

:CombinerNode a owl:Class ;
    rdfs:label "Combiner Node" .

### Proprietà Oggetto ###

:is_before a owl:ObjectProperty ;
    rdfs:label "Chronological Sequence" ;
    rdfs:comment "Indicates a temporal sequence where one item occurs before another." ;
    rdfs:domain :StratigraphicUnit ;
    rdfs:range :StratigraphicUnit .

:has_same_time a owl:ObjectProperty ;
    rdfs:label "Contemporaneous Elements" ;
    rdfs:comment "Indicates that two elements are contemporaneous." ;
    rdfs:domain :StratigraphicUnit ;
    rdfs:range :StratigraphicUnit .

:changed_from a owl:ObjectProperty ;
    rdfs:label "Temporal Transformation" ;
    rdfs:comment "Represents an object that changes over time." ;
    rdfs:domain :StratigraphicUnit ;
    rdfs:range :StratigraphicUnit .

:contrasts_with a owl:ObjectProperty ;
    rdfs:label "Contrasting Properties" ;
    rdfs:comment "Represents contrasting or mutually exclusive properties." ;
    rdfs:domain :PropertyNode ;
    rdfs:range :PropertyNode .

:has_first_epoch a owl:ObjectProperty ;
    rdfs:label "Has First Epoch" ;
    rdfs:comment "Indicates the initial epoch associated with a node." ;
    rdfs:domain :StratigraphicUnit ;
    rdfs:range :EpochNode .

:survive_in_epoch a owl:ObjectProperty ;
    rdfs:label "Survives In Epoch" ;
    rdfs:comment "Indicates that a node continues to exist in a given epoch." ;
    rdfs:domain :StratigraphicUnit ;
    rdfs:range :EpochNode .

:has_activity a owl:ObjectProperty ;
    rdfs:label "Part of Activity" ;
    rdfs:comment "Indicates that a node is part of a specific activity." ;
    rdfs:domain :StratigraphicUnit ;
    rdfs:range :ActivityNodeGroup .

:has_timebranch a owl:ObjectProperty ;
    rdfs:label "Included in Timebranch" ;
    rdfs:comment "Indicates that a node belongs to a specific time branch." ;
    rdfs:domain :StratigraphicUnit ;
    rdfs:range :TimeBranchNodeGroup .

:extracted_from a owl:ObjectProperty ;
    rdfs:label "Extracted From" ;
    rdfs:comment "Indicates that an Extractor node derives information from a Document node." ;
    rdfs:domain :ExtractorNode ;
    rdfs:range :DocumentNode .

:combines a owl:ObjectProperty ;
    rdfs:label "Combines" ;
    rdfs:comment "Indicates that a Combiner node combines information from various Extractor nodes." ;
    rdfs:domain :CombinerNode ;
    rdfs:range :ExtractorNode .

### Proprietà con Unione di Classi ###

# Definizione di una classe unione per "CombinerNode" e "ExtractorNode"
:CombinerOrExtractorNode a owl:Class ;
    owl:unionOf ( :CombinerNode :ExtractorNode ) .

:has_property a owl:ObjectProperty ;
    rdfs:label "Has Property" ;
    rdfs:comment "Connects a Combiner or Extractor node to one of its properties." ;
    rdfs:domain :CombinerOrExtractorNode ;
    rdfs:range :PropertyNode .

:generic_connection a owl:ObjectProperty ;
    rdfs:label "Generic Connection" ;
    rdfs:comment "Represents a non-specific connection between two nodes." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :StratigraphicUnit :PropertyNode ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :StratigraphicUnit :PropertyNode ) ] .
